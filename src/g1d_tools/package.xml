<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1d_tools</name>
  <version>0.1.0</version>
  <description>G1-D field tools: interface probe, /cmd_vel_no_limit behaviour probe (more in M7)</description>
  <maintainer email="hitliujianyun@163.com">hitliujianyun</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>unitree_go</exec_depend>
  <exec_depend>unitree_hg</exec_depend>
  <exec_depend>g1d_msgs</exec_depend>
  <exec_depend>g1d_core</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>g1d_sim</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
