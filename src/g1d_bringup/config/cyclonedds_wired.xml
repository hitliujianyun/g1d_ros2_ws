<?xml version="1.0" encoding="UTF-8"?>
<!-- Wired link to the robot network (192.168.123.0/24): multicast discovery on one interface.
     g1d_env.sh replaces G1D_NET_IF with the interface name. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="G1D_NET_IF" priority="default" multicast="default"/>
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
