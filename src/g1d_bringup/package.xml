<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1d_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, parameters and DDS configuration of the G1-D navigation stack</description>
  <maintainer email="hitliujianyun@163.com">hitliujianyun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>g1d_description</exec_depend>
  <exec_depend>g1d_robot_bridge</exec_depend>
  <exec_depend>g1d_guard</exec_depend>
  <exec_depend>g1d_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
